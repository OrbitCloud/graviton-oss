{
  "permissions": {
    "allow": [
      "Bash(cat *)",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(grep *)",
      "Bash(echo *)",
      "Bash(pwd)",
      "Bash(pwd *)",
      "Bash(which *)",
      "Bash(test *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(diff *)",
      "Bash(tr *)",
      "Bash(cut *)",
      "Bash(basename *)",
      "Bash(dirname *)",
      "Bash(realpath *)",

      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git merge-base *)",
      "Bash(git show *)",
      "Bash(git rev-parse *)",

      "Bash(git checkout *)",
      "Bash(git checkout -b *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git stash *)",
      "Bash(git branch *)",
      "Bash(git fetch *)",
      "Bash(git switch *)",

      "Bash(git push)",
      "Bash(git push -u origin *)",
      "Bash(git push origin HEAD)",

      "Bash(make *)",
      "Bash(poetry run *)",
      "Bash(python -m pytest *)",

      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr status)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr create *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr ready *)",

      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh issue create *)",
      "Bash(gh issue comment *)",

      "Bash(gh gist *)",

      "Bash(gh run view *)",
      "Bash(gh run list *)",
      "Bash(gh run watch *)",

      "WebSearch",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:gist.github.com)",
      "WebFetch(domain:gist.githubusercontent.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:learn.microsoft.com)",
      "WebFetch(domain:pulumi.com)",
      "WebFetch(domain:www.pulumi.com)",

      "mcp__context7__*",
      "mcp__fetch__*"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push --force-with-lease*)",
      "Bash(git push --delete*)",
      "Bash(git push * :*)",
      "Bash(git push * main)",
      "Bash(git push * main:*)",
      "Bash(git push * master)",
      "Bash(git push * master:*)",

      "Bash(git branch -D*)",
      "Bash(git branch --delete*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/post-push.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
