{
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.quickSuggestions": {
      "strings": true
    },
    "editor.suggest.insertMode": "replace"
  },
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnType": true,
    "editor.formatOnSave": true,
    "editor.rulers": [100],
    "editor.codeActionsOnSave": {
      "source.organizeImports": "always",
      "source.fixAll": "always"
    }
  },
  "python.analysis.packageIndexDepths": [
    {
      "name": "pulumi",
      "depth": 2
    },
    {
      "name": "pulumi_azure_native",
      "depth": 2
    },
    {
      "name": "pulumi_azuread",
      "depth": 2
    },
    {
      "name": "pydantic",
      "depth": 2
    }
  ],
  "terminal.integrated.profiles.osx": {
    "zsh": { "path": "/bin/zsh", "args": ["-l", "-i"] }
  },
  "search.exclude": {
    "**/.venv/**": true,
    "**/venv/**": true
  },
  "files.exclude": {
    "**/*.pyc": true,
    "**/.venv/**": true,
    "**/venv/**": true,
    "**/__pycache__/**": true,
    "**/.ruff_cache/**": true,
    "**/.pytest_cache/**": true
  },
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "files.trimTrailingWhitespace": true,
  "python.languageServer": "Pylance",
  "python.analysis.autoImportCompletions": true,
  "python.analysis.inlayHints.callArgumentNames": "partial",
  "python.analysis.inlayHints.functionReturnTypes": true,
  "python.analysis.inlayHints.pytestParameters": true,
  "python.analysis.inlayHints.variableTypes": true,
  "python.analysis.diagnosticMode": "openFilesOnly",
  "python.analysis.persistAllIndices": true,
  "python.analysis.indexing": true,
  "python.analysis.enablePytestSupport": true,
  "python.analysis.userFileIndexingLimit": 25000,
  "python.defaultInterpreterPath": ".venv/bin/python",
  "python.poetryPath": ".venv/bin/poetry",
  "python.terminal.activateEnvInCurrentTerminal": true,
  "python.terminal.activateEnvironment": true,
  "python.testing.pytestEnabled": true,
  "python.testing.pytestPath": ".venv/bin/pytest",
  "python.testing.unittestEnabled": false,
  "ruff.enable": true,
  "ruff.lint.run": "onType",
  "ruff.path": [".venv/bin/ruff"],
  "pythonIndent.trimLinesWithOnlyWhitespace": true,
  "yaml.hover": true
}
